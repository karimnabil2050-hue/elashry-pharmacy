rules_version = '2';

// قواعد أمان قاعدة البيانات
// - كل عميل يشوف بياناته وطلباته وروشتاته هو بس
// - الصيدلي (role = pharmacist) يشوف كل الطلبات ويعدّلها
// - محدش يقدر يخلّي نفسه صيدلي من التطبيق
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPharmacist() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pharmacist';
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- المستخدمين ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isPharmacist());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'customer';

      // العميل يعدّل اسمه وعنوانه وموقعه بس، مش الـ role
      allow update: if signedIn() && request.auth.uid == uid
        && onlyChanged(['name', 'address', 'lat', 'lng']);

      // الأدوية المزمنة: صاحبها بس
      match /chronic/{medId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- منتجات التجميل والعروض ----------
    // أي حد داخل يشوفها، والصيدلي بس يضيف ويعدّل ويمسح
    match /products/{productId} {
      allow read: if signedIn();
      allow write: if isPharmacist();
    }

    // ---------- الطلبات ----------
    match /orders/{orderId} {
      allow read: if signedIn() &&
        (resource.data.customerId == request.auth.uid || isPharmacist());

      // العميل يعمل طلب لنفسه بس، ويبدأ "جديد" ومن غير أسعار
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.items.size() == 0;

      // العميل: يوافق على عرض السعر أو يلغي قبل التجهيز
      // الصيدلي: يعدّل أي حاجة
      allow update: if isPharmacist() || (
        signedIn()
        && resource.data.customerId == request.auth.uid
        && onlyChanged(['status', 'updatedAt'])
        && (
          (resource.data.status == 'quoted' && request.resource.data.status == 'accepted')
          || (resource.data.status in ['pending', 'reviewing', 'quoted']
              && request.resource.data.status == 'cancelled')
        )
      );

      allow delete: if false;

      // صورة الروشتة
      match /attachments/{fileId} {
        allow read: if signedIn() &&
          (resource.data.customerId == request.auth.uid || isPharmacist());
        allow create: if signedIn()
          && request.resource.data.customerId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
